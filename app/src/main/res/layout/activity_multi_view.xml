<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 主内容区（仿 DS cam 图二） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical">

        <!-- 顶部导航栏 -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#1A1D21"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:id="@+id/btnDrawer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="#1E88E5"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTopTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="多路观看"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPageIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 / 1 页"
                    android:textColor="#9AA4B0"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnPageSwitch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⇄"
                android:textColor="#1E88E5"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/btnToggleTimeline"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="▦"
                android:textColor="#1E88E5"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/btnMoreMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#1E88E5"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 多路监控画面网格 -->
        <GridLayout
            android:id="@+id/cameraGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000" />

        <!-- 底部时间轴与控制区 -->
        <LinearLayout
            android:id="@+id/timelinePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#15181C"
            android:orientation="vertical">

            <!-- 控制行：暂停/播放 | 倍速 | 当前时间气泡 | 选日期 | LIVE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:background="#2A2F36"
                    android:gravity="center"
                    android:text="⏸"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnSpeed"
                    android:layout_width="44dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="1.0x"
                    android:textColor="#111827"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="#F3F4F6"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="--:--:--"
                    android:textColor="#1E88E5"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnPickDate"
                    android:layout_width="38dp"
                    android:layout_height="30dp"
                    android:background="#6B7280"
                    android:gravity="center"
                    android:text="日历"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnLive"
                    android:layout_width="48dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="#1E88E5"
                    android:gravity="center"
                    android:text="LIVE"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 可拖动时间刻度尺 -->
            <com.aivideo.app.TimelineRulerView
                android:id="@+id/timelineRuler"
                android:layout_width="match_parent"
                android:layout_height="62dp" />

            <!-- 最底部事件与快进快退工具栏 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#000000"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:id="@+id/btnPrevEvent"
                        android:layout_width="82dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⏮\n上一个事件"
                        android:textColor="#E5E7EB"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnNextEvent"
                        android:layout_width="82dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⏭\n下一个事件"
                        android:textColor="#E5E7EB"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:background="#2D333B" />

                    <TextView
                        android:id="@+id/btnRewind10"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⏪10\n快退"
                        android:textColor="#E5E7EB"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnForward10"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="10⏩\n快进"
                        android:textColor="#E5E7EB"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:background="#2D333B" />

                    <TextView
                        android:id="@+id/btnZoomIn"
                        android:layout_width="78dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⊕\n放大刻度"
                        android:textColor="#E5E7EB"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnZoomOut"
                        android:layout_width="78dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⊖\n缩小刻度"
                        android:textColor="#E5E7EB"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- 左侧抽屉菜单（仿 DS cam 图四） -->
    <LinearLayout
        android:id="@+id/drawerMenu"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#33373D"
        android:orientation="vertical">

        <!-- 抽屉顶部账号信息栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#3B4047"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="👤"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDrawerUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="admin"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDrawerHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="192.168.10.100"
                    android:textColor="#9AA4B0"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnDrawerLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="退出"
                android:textColor="#93C5FD"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 功能菜单列表 -->
        <TextView
            android:id="@+id/navMultiView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#0B77C5"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="⊞   多路观看"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/navCameras"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="📹   摄像机"
            android:textColor="#D1D5DB"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/navRecordings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="🎞   录制"
            android:textColor="#D1D5DB"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/navEvents"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="🔔   告警事件"
            android:textColor="#D1D5DB"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/navWebAdmin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="🌐   网页完整后台"
            android:textColor="#D1D5DB"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#4B525B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:text="登录过的地址"
            android:textColor="#9AA4B0"
            android:textSize="13sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/llSavedServers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
